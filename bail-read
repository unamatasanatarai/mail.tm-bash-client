#!/usr/bin/env bash

# authentication
. "${0%/*}/bail-token"

num="$1"
if [[ -z "$num" ]]; then
    printf 'error: provide message number\n' >&2
    exit 1
fi

__tmp_read="/tmp/bail-read.$$.tmp"
curl -s "$__url/messages" \
    -H "Authorization: Bearer $__token" >"$__tmp_read" || exit 1

count=$(jq -r '."hydra:member" | length' "$__tmp_read")

if ! [[ "$num" =~ ^[0-9]+$ ]] || ((num < 1 || num > count)); then
    printf 'error: invalid number\n' >&2
    rm -f "$__tmp_read"*
    exit 1
fi

idx=$((num - 1))
msg_id=$(jq -r ".\"hydra:member\"[$idx].id" "$__tmp_read")

curl -s "$__url/messages/$msg_id" \
    -H "Authorization: Bearer $__token" >"$__tmp_read.msg" || exit 1

printf 'from:\n'
jq -r '.from.address' "$__tmp_read.msg"
printf '\nsubject:\n'
jq -r '.subject' "$__tmp_read.msg"
printf '\nmessage:\n'
jq -r '
    if .text != null and .text != "" then
        .text
    elif .html != null and (.html | length) > 0 then
        .html[0] | gsub("<[^>]*>"; "")
    else
        "[no content]"
    end
' "$__tmp_read.msg"

rm -f "$__tmp_read"*
