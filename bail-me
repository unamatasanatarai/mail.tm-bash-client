#!/usr/bin/env bash

__url="https://api.mail.tm"
__v="0.5"

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
	printf 'bail-me v%s\n' "$__v"
	printf 'usage: bail-me [-h] [-v]\n\n'
	printf 'show current account profile data from mail.tm\n'
	exit 0
fi

if [[ "$1" == "-v" || "$1" == "--version" ]]; then
	printf 'bail-me v%s\n' "$__v"
	exit 0
fi
if [[ -z "$__token" ]]; then
	. "${0%/*}/bail-token"
fi

curl -s "$__url/me" \
	-H "Authorization: Bearer $__token" >"$__tmp.me"

if [[ $? -ne 0 ]]; then
	printf "error: failed to fetch profile data\n" >&2
	exit 1
fi

jq . "$__tmp.me"
rm -f "$__tmp.me"
