#!/usr/bin/env bash

# bail-me v0.5
# show current account profile data

__url="https://api.mail.tm"
__v="0.5"

# help
if [[ "$1" == "-h" || "$1" == "--help" || "$1" == "help" ]]; then
    printf 'bail-me v%s\n' "$__v"
    printf 'Usage: bail me\n\n'
    printf 'Show the current account profile details and mailbox quota.\n\n'
    printf 'Options:\n'
    printf '  -h, --help      Show this help message\n'
    printf '  -v, --version   Show version information\n\n'
    printf 'Examples:\n'
    printf '  bail me\n'
    exit 0
fi

# version
if [[ "$1" == "-v" || "$1" == "--version" ]]; then
    printf 'bail-me v%s\n' "$__v"
    exit 0
fi

if [[ -z "$__token" ]]; then
    . "${0%/*}/bail-token"
fi

__tmp_me="/tmp/bail-me.$$.tmp"
curl -s "$__url/me" \
    -H "Authorization: Bearer $__token" >"$__tmp_me"

if [[ $? -ne 0 ]]; then
    printf "error: failed to fetch profile\n" >&2
    exit 1
fi

jq . "$__tmp_me"
rm -f "$__tmp_me"
