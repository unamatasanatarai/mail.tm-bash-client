#!/usr/bin/env bash

__cache="${XDG_STATE_HOME:-$HOME/.config/state}/bail"
__acc="$__cache/account"
__v="0.6"

if [[ "$1" == "-h" || "$1" == "--help" || "$1" == "help" ]]; then
    printf 'bail-password v%s\n' "$__v"
    printf 'Usage: bail password\n\n'
    printf 'Display the current account password.\n\n'
    printf 'Options:\n'
    printf '  -h, --help      Show this help message\n'
    printf '  -v, --version   Show version information\n\n'
    printf 'Examples:\n'
    printf '  bail password\n'
    exit 0
fi

if [[ "$1" == "-v" || "$1" == "--version" ]]; then
    printf 'bail-password v%s\n' "$__v"
    exit 0
fi

if [[ ! -s "$__acc" ]]; then
    printf "error: no account found. run 'bail create' first.\n" >&2
    exit 1
fi

password=$(jq -r '.password' "$__acc")

if [[ -z "$password" || "$password" == "null" ]]; then
    printf "error: password not found in account data.\n" >&2
    exit 1
fi

if [[ -t 1 ]]; then
    printf "%s\n" "$password"
else
    printf "%s" "$password"
fi

