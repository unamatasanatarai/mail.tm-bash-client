#!/usr/bin/env bash

# defaults
__url="https://api.mail.tm"
__cache="${XDG_STATE_HOME:-$HOME/.config/state}/bail"
__acc="$__cache/account"
__tmp="/tmp/bail-create.$$.tmp"

# cleanup
trap 'rm -f "$__tmp"*' EXIT

# initialization
if [[ ! -d "$__cache" ]]; then
	mkdir -p "$__cache" || exit 1
fi

if [[ -s "$__acc" ]]; then
	"${0%/*}/bail-delete" >/dev/null 2>&1
fi

password=''
custom=0
prefix=''

while [[ $# -gt 0 ]]; do
	case "$1" in
	-p)
		shift
		password="$1"
		custom=1
		;;
	*)
		prefix="$1"
		;;
	esac
	shift
done

[[ "$custom" -eq 1 ]] || password="p_${RANDOM}${RANDOM}"

. "${0%/*}/bail-domain"
domain="$__domain"

if [[ -n "$prefix" ]]; then
	address="$prefix@$domain"
else
	address="user_${RANDOM}@$domain"
fi

printf '{"address":"%s","password":"%s"}' "$address" "$password" >"$__tmp.data"
curl -s "$__url/accounts" \
	-H 'Content-Type: application/json' \
	-d @"$__tmp.data" >"$__tmp.resp" || exit 1

jq --arg pw "$password" '. + {password: $pw}' "$__tmp.resp" >"$__acc" || exit 1

printf 'created\n'
printf 'address: %s\n' "$address"
printf 'password: %s\n' "$password"
