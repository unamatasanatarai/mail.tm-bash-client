#!/usr/bin/env bash

__cache="${XDG_STATE_HOME:-$HOME/.config/state}/bail"
__acc="$__cache/account"
__v="0.6"

if [[ "$1" == "-h" || "$1" == "--help" || "$1" == "help" ]]; then
	printf 'bail-email v%s\n' "$__v"
	printf 'Usage: bail email\n\n'
	printf 'Display the current account email address.\n\n'
	printf 'Options:\n'
	printf '  -h, --help      Show this help message\n'
	printf '  -v, --version   Show version information\n\n'
	printf 'Examples:\n'
	printf '  bail email\n'
	exit 0
fi

if [[ "$1" == "-v" || "$1" == "--version" ]]; then
	printf 'bail-email v%s\n' "$__v"
	exit 0
fi

if [[ ! -s "$__acc" ]]; then
	printf "error: no account found. run 'bail create' first.\n" >&2
	exit 1
fi

address=$(jq -r '.address' "$__acc")

if [[ -z "$address" || "$address" == "null" ]]; then
	printf "error: email address not found in account data.\n" >&2
	exit 1
fi

if [[ -t 1 ]]; then
	printf "%s\n" "$address"
else
	printf "%s" "$address"
fi
